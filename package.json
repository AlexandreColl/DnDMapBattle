{
  "name": "dndmapbattle",
  "version": "1.3.0",
  "private": true,
  "description": "DnD Battle Map - simulador de batallas multijugador",
  "license": "MIT",
  "author": "Alexandre Coll Molina",
  "homepage": "https://github.com/AlexandreColl/DnDMapBattle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandreColl/DnDMapBattle.git"
  },
  "bugs": {
    "url": "https://github.com/AlexandreColl/DnDMapBattle/issues"
  },
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "eslint . && prettier --check . && tsc -p . && vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
