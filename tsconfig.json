{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2024",
    "module": "nodenext",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "server",
    "public/js",
    "scripts",
    "test",
    "e2e",
    "types",
    "*.config.js"
  ]
}
